      "bannerUrl": "",
      "downloadItems": [
        {
          "id": "item-1786450869215-eprz",
          "title": "Bihar Tathya Sangrah",
          "description": "Final Attempt: बिहार तथ्य संग्रह\n\nBPSC एवं बिहार से जुड़ी प्रतियोगी परीक्षाओं के लिए एक स्मार्ट और Exam-Oriented पुस्तक।\n\n“बिहार तथ्य संग्रह” को Topic-Wise PYQs, Trend Analysis और बदलते Exam Pattern को ध्यान में रखकर तैयार किया गया है, ताकि अभ्यर्थी कम समय में महत्वपूर्ण Bihar Topics की प्रभावी तैयारी और Quick Revision कर सकें।\n\nप्रमुख विशेषताएँ:\n• Topic-Wise PYQs\n• Topic-Wise Trend Analysis\n• महत्वपूर्ण एवं परीक्षा-उपयोगी तथ्य\n• सरल और Quick Revision-Friendly प्रस्तुति\n• BPSC के बदलते पैटर्न के अनुरूप कंटेंट\n\nएक ऐसी पुस्तक, जो आपकी Bihar Special तैयारी को बनाए अधिक व्यवस्थित, स्मार्ट और Exam-Oriented।\n\nFINAL ATTEMPT - Let’s Make Your Attempt Final.\n",
          "type": "BPSC",
          "examCategory": "BPSC",
          "language": "Hindi",
          "editionYear": "2025-26 Edition",
          "price": 250,
          "discountedPrice": 156,
          "size": "12.7 MB",
          "url": "http://localhost:5000/uploads/pdfs/1784804575413_Sample_PDF________________-_________________________FinalAttempt.pdf",
          "thumbnailUrl": "http://localhost:5000/uploads/images/71rJ4Gp8UyL._SY385_.webp",
          "samplePdfUrl": "",
          "buyUrl": ""
        }
      ],
      "isPublished": true,
      "createdAt": "2026-08-11T12:08:44.511Z",
      "updatedAt": "2026-08-22T19:55:53.447Z"
    },
